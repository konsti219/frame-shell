#!/bin/sh
# Headset sleep in the Monado session. SteamVR puts its stack in standby before suspending; resuming with Monado,
# XRService (cameras, CVP) and the shell's decoders still running warm-resets the headset. So: stop them, suspend,
# start them again after the wake.
set -u
marker="$XDG_RUNTIME_DIR/monado-stopped-on-purpose"
touch "$marker"  # keeps frame-monado's fallback from switching to SteamVR while Monado is down
# The shell stops with Monado and starts with it again (frame-shell.service)
systemctl --user stop monado.service
success=$(cat /sys/power/suspend_stats/success)
fail=$(cat /sys/power/suspend_stats/fail)
systemctl suspend
# systemctl returns once the suspend is queued: wait for the wake (or a failed attempt), at most 10 minutes
for _ in $(seq 1200); do
    [ "$(cat /sys/power/suspend_stats/success)" != "$success" ] && break
    [ "$(cat /sys/power/suspend_stats/fail)" != "$fail" ] && break
    sleep 0.5
done
systemctl --user start monado.service
rm -f "$marker"
