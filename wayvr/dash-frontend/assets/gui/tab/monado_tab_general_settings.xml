<layout version="2">
  <include src="@/gui/t_group_box.xml" />

  <template name="CKRow">
    <div gap="8" width="~s_width">
      <CHILDREN/>
    </div>
  </template>

  <!-- title, id -->
  <template name="CKSlider">
    <div gap="8" flex_direction="column" width="100%">
      <label text="${title}"/>
      <Slider id="${id}" min_value="0" max_value="100" width="100%" height="24"/>
    </div>
  </template>

  <!-- title, id -->
  <template name="CKColSel">
    <div gap="8" flex_direction="column" width="100%">
      <label text="${title}"/>
      <ColorSelector id="cs_keying" height="24" width="100%"/>
    </div>
  </template>

  <vars>
    <var key="s_width" value="500"/>
  </vars>

  <elements>
    <div flex_direction="column" gap="8">
      <!-- headset brightness -->
      <GroupBox>
        <GroupBoxTitle src_builtin="@/dashboard/settings.svg" translation="GENERAL_SETTINGS" />

        <label translation="DISPLAY_BRIGHTNESS" />
        <Slider id="slider_brightness" width="300" height="24" min_value="0" max_value="140" />
      </GroupBox>

      <!-- Frame shell: positional timewarp of streamed frames (Monado reads $XDG_RUNTIME_DIR/frame-shell-timewarp) -->
      <GroupBox>
        <label text="Positional timewarp" weight="bold" size="18" color="secondary" />
        <label text="Corrects head movement since a streamed frame was rendered, at the depth your eyes focus on." wrap="1" width="~s_width" />
        <CKRow>
          <div gap="8" flex_direction="column" width="100%">
            <label text="Strength (%)"/>
            <Slider id="slider_tw_strength" min_value="0" max_value="100" step="5" show_value="1" width="100%" height="24"/>
          </div>
          <div gap="8" flex_direction="column" width="100%">
            <label text="Nearest depth (cm)"/>
            <Slider id="slider_tw_near" min_value="20" max_value="300" step="10" show_value="1" width="100%" height="24"/>
          </div>
          <div gap="8" flex_direction="column" width="100%">
            <label text="Far cutoff (m, 0 = none)"/>
            <Slider id="slider_tw_far" min_value="0" max_value="30" step="1" show_value="1" width="100%" height="24"/>
          </div>
        </CKRow>
        <CKRow>
          <div gap="8" flex_direction="column" width="100%">
            <label text="Max shift (mm)"/>
            <Slider id="slider_tw_max_shift" min_value="0" max_value="50" step="1" show_value="1" width="100%" height="24"/>
          </div>
          <div gap="8" flex_direction="column" width="100%">
            <label text="Depth smoothing (ms)"/>
            <Slider id="slider_tw_smoothing" min_value="0" max_value="300" step="10" show_value="1" width="100%" height="24"/>
          </div>
        </CKRow>
      </GroupBox>

      <!-- color keying -->
      <GroupBox>
        <GroupBoxTitle src_builtin="@/dashboard/settings.svg" translation="APP_SETTINGS.COLOR_KEYING" />
        <CKRow>
          <CKColSel title="Color" id="cs_keying"/>
          <CKSlider title="Despill" id="slider_keying_despill"/>
          <CKSlider title="Curve (0 = disabled)" id="slider_keying_curve"/>
        </CKRow>

        <CKRow>
          <CKSlider title="Hue range" id="slider_keying_hue_range"/>
          <CKSlider title="Saturation range" id="slider_keying_saturation_range"/>
          <CKSlider title="Value range" id="slider_keying_value_range"/>
        </CKRow>
      </GroupBox>
    </div>
  </elements>
</layout>
