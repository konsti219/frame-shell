<layout version="2">
  <elements>
    <div flex_direction="column" width="100%" padding="10" gap="12">
      <div flex_direction="column" width="100%" min_height="88" flex_shrink="0" gap="8">
        <div width="100%" justify_content="space_between">
          <label text="Headset speakers" size="14" weight="bold" />
          <label id="output_value" text="Connecting…" size="14" />
        </div>
        <Slider id="output_volume" height="20" min_height="20" flex_shrink="0" width="100%" min_value="0" max_value="100" step="1" />
        <CheckBox id="output_mute" text="Mute speakers" />
      </div>
      <div flex_direction="column" width="100%" min_height="88" flex_shrink="0" gap="8">
        <div width="100%" justify_content="space_between">
          <label text="Microphone" size="14" weight="bold" />
          <label id="mic_value" text="Connecting…" size="14" />
        </div>
        <Slider id="mic_volume" height="20" min_height="20" flex_shrink="0" width="100%" min_value="0" max_value="100" step="1" />
        <CheckBox id="mic_mute" text="Mute microphone" />
      </div>
    </div>
  </elements>
</layout>
